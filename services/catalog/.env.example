# Copy to services/catalog/.env and fill in the Cognito values. .env is gitignored.
#
# With `go run` from the host, the 127.0.0.1 addresses below reach the Compose Postgres
# and Redis. The Compose `catalog` service overrides DATABASE_URL, DATABASE_READER_URL
# and REDIS_ADDR itself.

PORT=8001
LOG_LEVEL=info

# X-Origin-Verify check (Interface Design §3.2). Keep it off locally.
ORIGIN_VERIFY_ENABLED=false
# ORIGIN_VERIFY_SECRET=

# Local Compose Postgres (deploy/local). In AWS: the RDS Proxy read/write endpoint and
# the read-only endpoint, both with sslmode=require. The reader defaults to the writer.
DATABASE_URL=postgres://catalog_svc:catalog_svc_local@127.0.0.1:5432/mycilinder?sslmode=disable
# DATABASE_READER_URL=

# Local Compose Redis. In AWS: the ElastiCache primary endpoint, REDIS_TLS=true, and the
# AUTH token in REDIS_PASSWORD.
REDIS_ADDR=127.0.0.1:6379
# REDIS_PASSWORD=
REDIS_TLS=false

# Same Cognito user pool and app client as the auth facade. No client secret is needed:
# Catalog only verifies access tokens.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=
OPERATORS_GROUP=operators

# AWS dev stack (SQS, S3). Locally the Compose service mounts ~/.aws read-only and uses
# AWS_PROFILE; on ECS leave AWS_PROFILE unset and the task role is used.
AWS_REGION=us-east-1
# AWS_PROFILE=mycilinder-dev

# video-status-queue consumer.
CONSUMER_ENABLED=false
# VIDEO_STATUS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/video-status-queue

# Background jobs (expiry, stuck-processing sweep, HLS output cleanup).
JOBS_ENABLED=false
# HLS_OUTPUT_BUCKET=
# Go durations (no "d" unit: 7 days is 168h). For a quick demo: JOB_INTERVAL=10s,
# OUTPUT_RETENTION=1m.
JOB_INTERVAL=15m
PENDING_UPLOAD_EXPIRY=24h
PROCESSING_TIMEOUT=2h
CLEANUP_INTERVAL=24h
OUTPUT_RETENTION=168h

# Signed playback cookies. Set all three or none. Put the private key at
# services/catalog/secrets/cloudfront.pem (gitignored); Compose mounts that directory
# read-only at /run/secrets/catalog. With `go run`, point the variable at the host path.
# CLOUDFRONT_DOMAIN=dxxxxxxxxxxxx.cloudfront.net
# CLOUDFRONT_KEY_PAIR_ID=
# CLOUDFRONT_PRIVATE_KEY_FILE=/run/secrets/catalog/cloudfront.pem
