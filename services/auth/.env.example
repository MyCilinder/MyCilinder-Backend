# Copy to services/auth/.env and fill in the Cognito values. .env is gitignored.
#
# With `go run` from the host, the 127.0.0.1 addresses below reach the Compose Postgres
# and Redis. The Compose `auth` service overrides DATABASE_URL and REDIS_ADDR itself.

PORT=8000
LOG_LEVEL=info

# X-Origin-Verify check (Interface Design §3.2). Keep it off locally.
ORIGIN_VERIFY_ENABLED=false
# ORIGIN_VERIFY_SECRET=

# Local Compose Postgres (deploy/local). In AWS this points at RDS Proxy with sslmode=require.
DATABASE_URL=postgres://auth_svc:auth_svc_local@127.0.0.1:5432/mycilinder?sslmode=disable

# Local Compose Redis. In AWS: the ElastiCache primary endpoint, REDIS_TLS=true, and the
# AUTH token in REDIS_PASSWORD.
REDIS_ADDR=127.0.0.1:6379
# REDIS_PASSWORD=
REDIS_TLS=false

# Cognito dev user pool, created in the AWS console (see services/auth/README.md).
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# Number of proxies that append to X-Forwarded-For. 0 locally (use the TCP peer).
TRUSTED_PROXY_HOPS=0

# Failed-login throttling (SEC-09).
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW=15m

# Request limit per client IP on the public /auth/* routes.
PUBLIC_AUTH_MAX_REQUESTS_PER_IP=30
PUBLIC_AUTH_WINDOW=1m
