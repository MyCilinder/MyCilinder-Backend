@startuml c4-level3-catalog
' MyCilinder: C4 Level 3, Catalog / Metadata API components
' Components of services/catalog (Go), one per package under internal/; shared pieces
' come from libs/go. Matches the implementation on feat/catalog.
' Sources: Architecture §2.3 and §4.2, Interface Design §1.2, §1.3, §2.1, Data Design §1.1 and §3.

!include <C4/C4_Component>

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title MyCilinder: Catalog / Metadata API components (C4 Level 3)

Container(alb, "Internal ALB", "Application Load Balancer", "Routes /feed, /search, /creators/*, /videos/*, /me/videos, /ops/videos/*.")
ContainerQueue(status_q, "SQS video-status-queue", "Amazon SQS", "video.processing, video.ready, video.failed.")

Container_Boundary(catalog, "Catalog / Metadata API (Go, ECS Fargate)") {
    Component(router, "HTTP router + middleware", "internal/http, chi, libs/go/middleware", "Origin-header check, correlation id, logging, JWT validation (required, optional, or operator group), Problem Details errors.")
    Component(health, "Health handlers", "libs/go/health", "/healthz and /readyz.")

    Component(browse_h, "Browse handlers", "internal/http", "GET /feed, GET /search, GET /creators/{userId}/videos. Cursor pagination.")
    Component(video_h, "Video and studio handlers", "internal/http", "GET, PATCH, DELETE /videos/{videoId}; GET /me/videos; GET /videos/{videoId}/playback.")
    Component(ops_h, "Operator handlers", "internal/http", "POST /ops/videos/{videoId}/hide and /restore.")

    Component(browse_svc, "Browse service", "internal/browse, internal/cursor", "Recent and most-viewed feeds, Spanish full-text search, creator pages. Keyset cursors bound to their list.")
    Component(video_svc, "Video service", "internal/video", "Domain types and title rules. Visibility: 404 for non-owners unless READY.")
    Component(studio_svc, "Studio service", "internal/studio", "/me/videos, edits, soft delete. Row lock and owner checks (403 if READY, else 404).")
    Component(moderation_svc, "Moderation service", "internal/moderation", "Hide and restore; status change and audit row in one transaction.")
    Component(lifecycle, "Video lifecycle", "internal/lifecycle", "Forward-only transition table and conditional UPDATE. The only code that changes videos.status; reports duplicates and conflicts.")
    Component(playback_svc, "Playback service", "internal/playback", "Checks visibility, builds the master playlist URL and the cookie policy for /videos/{videoId}/* (2 h).")
    Component(signer, "Cookie signer", "internal/cfsign, AWS SDK for Go v2", "Signs the custom policy (SHA-1, exactly 3 cookies) and sets Path, Max-Age, SameSite=None, Partitioned.")

    Component(consumer, "Status event consumer", "internal/events, AWS SDK for Go v2", "Long-polls video-status-queue, parses the envelope (raw or SNS-wrapped), applies it through the lifecycle, deletes the message unless it is invalid or the database failed.")
    Component(jobs, "Background jobs", "internal/jobs", "Every 15 min: expire PENDING_UPLOAD after 24 h; mark PROCESSING after 2 h as FAILED. Daily: delete HLS outputs 7 days after deletion. Each run takes pg_try_advisory_xact_lock.")

    Component(video_repo, "Video repository", "internal/store, pgx", "catalog.videos on the writer; feed and search queries on the reader. Reads auth.v_user_public and interactions.v_video_stats.")
    Component(cache, "Cache", "internal/cache, go-redis", "Feed and search pages (30 s) and READY video detail (60 s), single-flight. Detail entries deleted on every write; Redis errors fall back to Postgres.")
    Component(output_store, "Output cleaner", "internal/storage, AWS SDK for Go v2", "Lists and deletes videos/{videoId}/ and the thumbnail in hls-output.")
    Component(audit_repo, "Audit writer", "internal/store, pgx", "INSERT-only into audit.audit_log (video.hidden, video.restored), inside the caller's transaction.")
    Component(config, "Config", "internal/config, libs/go/config", "Environment variables; CloudFront private key from a PEM file (Secrets Manager not wired yet).")
}

ContainerDb(proxy, "RDS Proxy", "Amazon RDS Proxy", "Read/write and read-only endpoints.")
ContainerDb(redis, "ElastiCache Redis", "Redis", "Feed cache, rate-limit counters.")
ContainerDb(hls, "S3 hls-output", "Amazon S3", "HLS outputs and thumbnails.")
Container_Ext(secrets, "Secrets Manager", "AWS Secrets Manager", "Service secrets (planned).")

Rel(alb, router, "HTTP requests", "HTTP")
Rel(alb, health, "Health checks", "HTTP")
Rel(router, browse_h, "Public routes")
Rel(router, video_h, "Optional, JWT, or owner routes")
Rel(router, ops_h, "Operator routes")

Rel(browse_h, browse_svc, "Calls")
Rel(video_h, video_svc, "Calls")
Rel(video_h, playback_svc, "Calls")
Rel(video_h, studio_svc, "Calls")
Rel(ops_h, moderation_svc, "Calls")

Rel(browse_svc, cache, "Get / set pages")
Rel(browse_svc, video_repo, "On cache miss")
Rel(video_svc, cache, "Detail, cache-aside")
Rel(video_svc, video_repo, "On cache miss")
Rel(studio_svc, video_repo, "Lists and edits")
Rel(studio_svc, lifecycle, "Delete")
Rel(moderation_svc, lifecycle, "Hide, restore")
Rel(moderation_svc, audit_repo, "Same transaction")
Rel(playback_svc, video_svc, "Visibility check")
Rel(playback_svc, signer, "Signs policy")

Rel(consumer, status_q, "Receive, delete", "SQS long poll")
Rel(consumer, lifecycle, "Applies event")
Rel(jobs, lifecycle, "Expire, mark FAILED")
Rel(jobs, output_store, "Cleanup of deleted videos")
Rel(jobs, video_repo, "Batches + advisory lock")
Rel(lifecycle, video_repo, "Conditional status update")
Rel(lifecycle, cache, "Deletes video:{id} after commit")

Rel(video_repo, proxy, "SQL", "PostgreSQL, TLS")
Rel(audit_repo, proxy, "SQL", "PostgreSQL, TLS")
Rel(cache, redis, "Commands", "RESP, TLS")
Rel(output_store, hls, "ListBucket, DeleteObject", "AWS SDK")
Rel(health, proxy, "Ping", "PostgreSQL, TLS")
Rel(config, secrets, "Planned", "HTTPS")

@enduml
